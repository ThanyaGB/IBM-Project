# ─────────────────────────────────────────────────────────────────────────────
# health-myth-bot — Environment Variables
#
# Copy this file to .env and fill in real values before running the app.
# NEVER commit .env to version control (it is already in .gitignore).
#
# Everything here is free. There is no paid credential in this file, and the
# architecture is designed so that none is needed:
#   * WhatsApp Cloud API  — inbound messages are never charged, and a
#     non-template reply inside the 24-hour window the user's message opens is
#     free. The bot only ever replies, so it never sends a billable template.
#   * Gemini free tier    — or Ollama running locally, for zero cost and zero
#     data leaving the machine.
#   * Local models        — embeddings, speech-to-text and speech synthesis all
#     run on the machine (see requirements.txt).
# ─────────────────────────────────────────────────────────────────────────────

# ── Channel ───────────────────────────────────────────────────────────────────
# whatsapp (default, free, official) or twilio (legacy adapter).
CHANNEL=whatsapp

# Reject webhooks that are not correctly signed. Leave this ON. Turning it off
# lets anyone who learns the URL inject messages into the bot; the only reason
# to disable it is the automated test suite.
VALIDATE_WEBHOOK_SIGNATURES=true

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
# Meta app dashboard → WhatsApp → API Setup / Configuration.
# A development-mode test number is free and can message up to 5 verified
# recipient numbers, which is enough for a demo with no billing.
WHATSAPP_ACCESS_TOKEN=your_permanent_or_temporary_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# Used to verify the X-Hub-Signature-256 header on every inbound request.
WHATSAPP_APP_SECRET=your_meta_app_secret
# Must match the verify token you type into the webhook configuration.
WHATSAPP_VERIFY_TOKEN=choose_a_random_string
# API version for the Graph calls.
GRAPH_API_VERSION=v21.0
# Interactive reply buttons (👍/👎). Set to false only for an older API version.
SUPPORTS_INTERACTIVE_MESSAGES=true

# ── Website demo (landing page + phone emulator) ─────────────────────────────
# URL the landing page's "Open live dashboard" button points at. Keep the
# default while the Streamlit dashboard runs on this machine.
DASHBOARD_URL=http://localhost:8501
# Per-visitor hourly cap on demo questions, independent of RATE_LIMIT_PER_HOUR.
# Guards the free-tier LLM budget when the landing page is public.
DEMO_RATE_LIMIT_PER_HOUR=30

# ── Answer generation (pick at least one — both are free) ─────────────────────
# Gemini free tier. Note: on the free tier Google may use submitted content to
# improve its products, so do not route data through it that must stay private.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite

# Local generation via Ollama — free, offline, and nothing leaves the machine.
# Recommended for real patient questions. https://ollama.com
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ── Flask server ──────────────────────────────────────────────────────────────
FLASK_PORT=5000

# ── Operations ────────────────────────────────────────────────────────────────
# Kill switch. Also overridable at runtime from the dashboard, which is the
# point: pausing must not need a redeploy.
BOT_ENABLED=true
# Per-user questions per hour before the bot asks the user to slow down.
RATE_LIMIT_PER_HOUR=20
# Speak the answer when the user sent a voice note. Requires edge-tts + ffmpeg.
VOICE_REPLIES=true
# Re-send the same category advisory no more often than this.
ADVISORY_COOLDOWN_HOURS=12

# ── Dashboard access control ──────────────────────────────────────────────────
# Leave blank to disable the password gate (not recommended in production).
DASHBOARD_PASSWORD=changeme

# ── Retrieval (all optional — the keyword/BM25 path needs none of it) ─────────
# Multilingual embedding model for dense retrieval. One-time download:
#   python retrieval.py --download-model
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_CACHE_DIR=
# RETRIEVAL_DENSE_FLOOR=0.55
# RETRIEVAL_MIN_SCORE=0.30

# ── Speech ────────────────────────────────────────────────────────────────────
# Local STT model size (tiny/base/small/medium). "base" is a good speed/accuracy
# trade-off for Hindi and Kannada voice notes.
# WHISPER_MODEL=base
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE_TYPE=int8
# TTS_VOICE_HI=hi-IN-SwaraNeural
# TTS_VOICE_KN=kn-IN-SapnaNeural
# TTS_VOICE_EN=en-IN-NeerjaNeural
# Path to ffmpeg when it is not on PATH.
# FFMPEG_PATH=

# ── Cards ─────────────────────────────────────────────────────────────────────
# Headless Chromium is required for correct Devanagari/Kannada shaping; without
# it the Pillow fallback renders English text only.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CARDS_DIR=./static/cards
# AUDIO_DIR=./static/audio

# ── Optional overrides ────────────────────────────────────────────────────────
# DB_PATH=data/health_myth_bot.db
# HEALTH_FACTS_PATH=data/health_facts.json
# MAX_AUDIO_BYTES=16777216

# ── Legacy Twilio channel (only when CHANNEL=twilio) ──────────────────────────
# Note: Twilio WhatsApp is NOT free — it charges per message in both directions.
# Kept for existing deployments only; the default channel above has no per
# message cost.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Public base URL serving card images. Unused by the Cloud API channel, which
# uploads media and references it by id instead of needing a public URL.
# CARD_BASE_URL=
