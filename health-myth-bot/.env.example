# ─────────────────────────────────────────────────────────────────────────────
# health-myth-bot — Environment Variables
# Copy this file to .env and fill in real values before running the app.
# NEVER commit .env to version control (it is already in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Twilio ────────────────────────────────────────────────────────────────────
# Find these in https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# ── Google Gemini (used for both chat and audio transcription) ──────────────
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the default Gemini model for transcription
# Options: gemini-3.5-flash-lite (default, fastest), gemini-3.1-flash-lite, gemini-3.5-transcribe (dedicated STT)
# GEMINI_MODEL=gemini-3.5-flash-lite

# ── Flask server ──────────────────────────────────────────────────────────────
# Port Flask listens on. Default: 5000
FLASK_PORT=5000

# ── Dashboard access control (stretch goal 4.7) ───────────────────────────────
# Password for the Streamlit analytics dashboard.
# Leave blank to disable the password gate (not recommended in production).
DASHBOARD_PASSWORD=changeme

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "true" if your Twilio account supports WhatsApp interactive messages
# (buttons / list pickers). Defaults to false — falls back to plain text.
SUPPORTS_INTERACTIVE_MESSAGES=false

# ── Optional overrides ────────────────────────────────────────────────────────
# Path to the SQLite database file. Default: health_myth_bot.db (project root)
# DB_PATH=health_myth_bot.db

# Directory for the ChromaDB persistent vector store. Default: ./chroma_db
# CHROMA_DB_DIR=./chroma_db

# Path to the health facts JSON file. Default: health_facts.json (project root)
# HEALTH_FACTS_PATH=health_facts.json

# Base URL at which myth-fact card images are publicly served (stretch goal 4.6).
# Required only if you want Twilio to attach the card image to replies.
# Example: https://your-server.example.com/cards
# CARD_BASE_URL=
